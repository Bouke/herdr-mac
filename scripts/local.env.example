# Copy to scripts/local.env (not committed) and fill in for this machine.

# Where scripts/publish.sh puts releases: a synced folder named herdr-mac that the people
# who use the app sync to their Macs (e.g. a shared OneDrive folder).
# HERDR_MAC_RELEASES=~/Library/CloudStorage/OneDrive-<organisation>/herdr-mac

# Where scripts/ghosttykit.sh finds Ghostty's source and the zig to build it with.
# GHOSTTY_SRC=~/src/ghostty
# ZIG=~/zig-0.17/zig
